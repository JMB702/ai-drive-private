{
  "name": "@aidrive/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run clean",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start -p 3000",
    "clean": "node -e \"const fs=require('fs');['.next','.next-runtime','.next-dev','.next-prod'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "lint": "next lint",
    "test": "vitest run -c vitest.config.ts"
  },
  "dependencies": {
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/node": "^22.10.2"
  }
}
